<html xmlns:IE>

<head>
    <meta http-equiv='Expires' content='0'>
    <meta http-equiv='Pragma' content='no-cache'>
    <meta http-equiv='Cache-Control' content='no-cache'>
    <meta name="description"
        content="Play RuneScape, the world's most popular free MMORPG. Start your adventure, complete quests and win enormous treasures in a 3D world of magic and monsters.">
    <link rel="icon" type="image/vnd.microsoft.icon" href="/favicon.ico" />
    <link rel="SHORTCUT ICON" href="/favicon.ico" />
    <title>Old School RuneScape Game</title>
    <style>
        body,
        td,
        p {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 11px;
        }

        body {
            margin: 0;
            overflow: auto;
            background: black;
            color: white;
        }

        input {
            margin: 0;
            font-size: 11px;
            height: 20px;
            vertical-align: middle;
        }

        input.s {
            background-color: #D2BB86;
            border: solid 2px #382418;
            color: black;
        }

        input.t {
            background: url('/gamewin/sb.gif');
            border: 0;
            color: white;
            width: 49px;
        }

        img {
            vertical-align: middle;
            border: 0;
        }

        td {
            vertical-align: middle;
        }

        a {
            color: white;
        }
        a:focus, 
        input:focus, 
        button:focus, 
        canvas:focus {
            outline: none !important;
        }

        canvas {
            width: 765px;
            height: 503px;
            display: block;
            -webkit-touch-callout: none;
            -webkit-user-select: none;
            -khtml-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
            outline: none;
            -webkit-tap-highlight-color: rgba(255, 255, 255, 0);
            z-index: -1;
            image-rendering: pixelated;
        }

        #game {
            padding-left: 0;
            padding-right: 0;
            margin-left: auto;
            margin-right: auto;
            display: block;
        }
    </style>
    <IE:clientCaps ID="oClientCaps"></IE:clientCaps>
    <script src='/js/jquery/jquery_1_7.js'></script>
</head>

<body>
    <center>
        <table cellpadding=0 cellspacing=1>
            <tr>
                <td align=center>
                    <table border=0 background="/gamewin/navbar.gif" cellspacing=0 cellpadding=0 width=765 height=25>
                        <tr>
                            <td width=5></td>
                            <td>
                                <img src="/jagex_logo_79x21.png">
                            </td>
                            <td></td>
                            <td>
                                <a href="/" ID="menulink" tabindex="-1">
                                    <img src="/gamewin/navbar_mainmenu.gif">
                                    Main Menu
                                </a>
                            </td>
                            <td></td>
                            <td>
                                <a href="/slu" tabindex="-1">
                                    <img src="/gamewin/navbar_mainmenu.gif">
                                    World Select
                                </a>
                            </td>
                            <td></td>
                            <td>
                                <a href="/gamewin/runescape-map-24-july-07.jpg" target="WorldMap"
                                    onclick="window.open('/gamewin/runescape-map-24-july-07.jpg','WorldMap','width=635,height=550'); return false;" tabindex="-1">
                                    <img src="/gamewin/navbar_worldmap.gif">
                                    World Map
                                </a>
                            </td>
                            <td></td>
                            <td>
                                <a href="#"
                                    target="RulesSecurity" tabindex="-1">
                                    <img src="/gamewin/navbar_rules.gif">
                                    Rules
                                </a>
                            </td>
                            <td></td>
                            <td align=right width=210>
                                <a href="#"
                                    target="Manual" tabindex="-1"><img src="/gamewin/navbar_manual.gif"
                                        style="vertical-align: top;"></a>
                                <form action="https://oldschool.runescape.wiki" method="get"
                                    target="_blank" style="display:inline">
                                    <input id="Search" name="search" class="s" type="text" title="Search the RuneScape Wiki"
                                        name="text" size="15" tabindex="-1">
                                    <input type="submit" class="t" title="Find" name="search" value="Search" tabindex="-1">
                                </form>
                            </td>
                            <td width=5></td>
                        </tr>
                    </table>
                </td>
            </tr>
            <tr>
                <td align=center>
                <div id="game">
                    <canvas id="canvas" width="765" height="503" tabindex="0">
                        Your browser is not capable of running our web client.
                    </canvas>
                </div>
                </td>
            </tr>
        </table>
    </center>
    <script language="javascript">
        $(function () {
            document.domain = window.location.hostname;

            $('a').click(function () {
                var $this = $(this);
                var target = $this.attr("target");
                if ((target == undefined || target == "" || target == "_parent" || target == "_top")) {
                    return confirm("'Please make sure you have logged out of the game before navigating away.'");
                }
            });

            window.scroll(0, 0);
        });
    </script>
    <script>
        const canvas = document.getElementById('canvas');
        if (canvas) {
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = 'black';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = 'white';
            ctx.font = 'bold 20px Arial';
            ctx.textAlign = 'center';
            ctx.fillText('Loading...', canvas.width / 2, canvas.height / 2);

            canvas.focus();

            canvas.addEventListener('click', function() {
                canvas.focus();
            });
            window.addEventListener('keydown', function(e) {
                if (document.activeElement === canvas) {
                    const keysToPrevent = ['Space', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'];
                    if (keysToPrevent.includes(e.code) || [32, 37, 38, 39, 40].includes(e.keyCode)) {
                        e.preventDefault();
                    }
                }
            }, { passive: false });
        }
    </script>

    <script type="module">
        import { Client } from './client/client.js';

        (() => {
            const url = new URL(window.location.href);
            
            const defaultParams = {
                worldid: '1',
                members: '1',      // 1 = Members world, 0 = Free world
                modewhere: '1',    // Environment setting
                lowmem: '0',       // 1 = Low memory, 0 = High memory
                lang: '0',         // 0 = English, 1 = German
                game: '0',         // Game variation
                js: '1',
                plug: '0',
                affid: '0'
            };
            let updated = false;
            for (const [key, value] of Object.entries(defaultParams)) {
                if (!url.searchParams.has(key)) {
                    url.searchParams.set(key, value);
                    updated = true;
                }
            }

            if (updated) {
                window.history.replaceState({}, '', url.toString());
            }

            new Client();
        })();
    </script>
</body>

</html>
